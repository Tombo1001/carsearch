{
  "name": "carsearch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Work out what an older car would actually cost you to drive, by overlaying your own driving history on the UK's clean-air, low-emission and congestion zones.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "data:zones": "node scripts/build-zones.mjs",
    "data:catalogue": "node scripts/build-catalogue.mjs",
    "data:check": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "proj4": "^2.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
